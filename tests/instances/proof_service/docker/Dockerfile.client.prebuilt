# Runtime-only Docker image for pre-built proof client
# Build the binary on the host first with: cargo build --release -p proof_client

FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libssl3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy the pre-built binary from host
COPY target/release/proof_client /app/proof_client

# Create directories for input and output
RUN mkdir -p /app/input /app/output /app/binary

# Set default environment variables
ENV RUST_LOG=info

# Run the client
ENTRYPOINT ["/app/proof_client"]
